# PPREV — environment template
# Copy to .env.local and fill in. NEVER commit the filled version.
# All secrets stay on Recep's machine / deployment. Akif works against mock + public API URL.

# ─── Hedera (testnet) ────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
OPERATOR_ID=0.0.xxxxxx
OPERATOR_KEY=

# Demo accounts — created by `npm run accounts:create`, then pasted here.
BUYER1_ID=0.0.xxxxxx
BUYER1_KEY=
BUYER2_ID=0.0.xxxxxx
BUYER2_KEY=
NOKYC_ID=0.0.xxxxxx
NOKYC_KEY=

# Leave BOTH of these EMPTY on a fresh checkout.
#
# `npm run bootstrap` treats any non-empty value as "the topic already exists" and exits
# reporting success without creating one — so a placeholder here means no audit topic is
# ever opened and every HCS write fails against an id that does not exist.
#
#   AUDIT_TOPIC_ID  opened by `npm run bootstrap`
#   SEED_TOKEN_ID   minted by `npm run golden` (rewritten on every run)
AUDIT_TOPIC_ID=
SEED_TOKEN_ID=

# ─── World ID 4.0 ────────────────────────────────────────────────────────────
# developer.world.org → create app → the app page shows all three values.
# The signing key is shown once; it never leaves the server.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxxxxx
WORLD_RP_ID=rp_xxxxxxxx
WORLD_SIGNING_KEY=0x...
# "staging" routes to the World simulator; set to "production" for real credentials.
WORLD_ENVIRONMENT=staging

# Three separate incognito actions must exist in the portal with these exact ids.
# verify-tenant is deliberately separate from verify-buyer: a nullifier is derived from
# (identity, app, action), so a shared action would stop one person from being both a
# buyer and a tenant during the demo.
#   onboard-seller  → Selfie Check     (seller / landlord abuse prevention)
#   verify-buyer    → Identity Check   (buyer eligibility → Hedera KYC grant)
#   verify-tenant   → Identity Check   (tenant age + income threshold)

# ─── ENS (Sepolia) ───────────────────────────────────────────────────────────
ENS_PARENT_NAME=pprevlisbon.eth
ENS_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Verifier (minimal, Ed25519) ─────────────────────────────────────────────
# Generated by `npm run verifier:keygen`. Public key also published to ENS.
VERIFIER_PRIVATE_KEY=
VERIFIER_PUBLIC_KEY=
ATTESTATION_TTL_SECONDS=3600

# Seller session lifetime. Default 30. Raise it for a long rehearsal day: the rental flow
# holds one session across list -> apply -> engage -> lock window -> settle, so a long lock
# window can expire the session before the landlord is allowed to release the deposit.
SELLER_SESSION_TTL_MINUTES=30

# ─── Server-side secrets ─────────────────────────────────────────────────────
# Used to derive private replay digests from World nullifiers. Never leaves the server.
NULLIFIER_HMAC_SECRET=
# Guards the verifier panel endpoints.
DEMO_ADMIN_SECRET=

# ─── ENS fallback (used only when Sepolia resolution fails) ──────────────────
# Mirrors what the ENS records hold, so a flaky RPC can't kill the demo.
# Required, and only used when Sepolia cannot be reached — so leaving it blank breaks the
# exact outage it exists to survive: /api/ens-read then throws ENS_CONFIG_INCOMPLETE.
# For the SALE policy this is sha256("PPREV_POLICY_SALE_V1"); see scripts/ens-write.ts.
FALLBACK_POLICY_HASH=
FALLBACK_POLICY_VERSION=1
# Leave empty to fall back to OPERATOR_ID. A placeholder here is truthy and wins over that
# fallback, which is worse than leaving it blank.
FALLBACK_REVENUE_TREASURY=
FALLBACK_RENTAL_ESCROW_ACCOUNT=
FALLBACK_RENTAL_REQ_DEPOSIT=50
